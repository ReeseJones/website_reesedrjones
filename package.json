{
  "name": "website_reesedrjones",
  "private": true,
  "version": "1.0.0",
  "source": "./src/index.html",
  "scripts": {
    "generate:shaders": "node scripts/generate_shader_types.js",
    "start": "npm run generate:shaders && rimraf dist && parcel",
    "clean": "rimraf .parcel-cache dist",
    "build": "npm run generate:shaders && parcel build src/index.html --public-url /",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.2.6",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@parcel/resolver-glob": "^2.16.4",
    "@parcel/transformer-glsl": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "parcel": "^2.14.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.98.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
