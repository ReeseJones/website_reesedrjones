{
  "name": "website_reesedrjones",
  "private": true,
  "version": "1.0.0",
  "source": "./src/index.html",
  "scripts": {
    "generate:shaders": "node scripts/generate_shader_types.js",
    "generate:version": "node scripts/generate_version.js",
    "prepare": "npm run generate:shaders && npm run generate:version",
    "start": "npm run generate:shaders && npm run generate:version && rimraf dist && parcel",
    "clean": "rimraf .parcel-cache dist",
    "build": "rimraf dist && npm run generate:shaders && npm run generate:version && parcel build src/index.html --public-url /",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsc --noEmit && vitest run --reporter=dot --bail 1"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "gl-matrix": "^3.4.4",
    "lit": "^3.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.2.6",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@parcel/resolver-glob": "^2.16.4",
    "@parcel/transformer-glsl": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "happy-dom": "^20.14.5",
    "parcel": "^2.14.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.98.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
